# Copy this file to .env and fill in real values. Never commit .env.

# ---- Required ----------------------------------------------------------------

# IAM access key with polly:SynthesizeSpeech, polly:DescribeVoices,
# transcribe:StartStreamTranscription, transcribe:StartStreamTranscriptionWebSocket,
# and bedrock:InvokeModel + bedrock:InvokeModelWithResponseStream.
AWS_APP_ID=AKIAIOSFODNN7EXAMPLE
AWS_APP_SECRET=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# AWS region. Must be one where you have enabled Claude model access in Bedrock.
REGION=us-east-1

# ---- Server ------------------------------------------------------------------

PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# Comma-separated. Requests from other origins are rejected.
ALLOWED_ORIGINS=http://localhost:3000

# Set to true only when running behind a reverse proxy or load balancer,
# otherwise every client shares one rate-limit bucket.
TRUST_PROXY=false

# ---- Claude on Bedrock -------------------------------------------------------

# Bedrock model IDs carry an "anthropic." prefix. Current-generation models
# generally require a cross-region inference profile to be enabled for your
# account: if calls fail with AccessDeniedException or ValidationException,
# check the Bedrock console before suspecting the code.
CLAUDE_MODEL_ID=anthropic.claude-opus-5
CLAUDE_MAX_TOKENS=16000
CLAUDE_MAX_TOKENS_STREAMING=64000

# low | medium | high | xhigh | max. Controls how much the model thinks and
# spends. Note that max_tokens caps thinking plus response text together.
CLAUDE_EFFORT=high

# ---- Cost estimation ---------------------------------------------------------

# Per-million-token rates, taken from the AWS Bedrock pricing page for YOUR
# region. Bedrock is partner-operated, so AWS sets these and they are not
# Anthropic's first-party prices.
#
# Left at 0 the app reports the cost estimate as unavailable rather than
# showing $0.00 - a confidently wrong number is worse than no number.
PRICE_INPUT_PER_MILLION=0
PRICE_OUTPUT_PER_MILLION=0
PRICE_CACHED_INPUT_PER_MILLION=0

# ---- Rate limiting -----------------------------------------------------------

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_SPEAK=30
RATE_LIMIT_ASK_CLAUDE=30
RATE_LIMIT_SIGNED_URL=10

# ---- Speech synthesis --------------------------------------------------------

POLLY_DEFAULT_VOICE=Matthew
POLLY_DEFAULT_ENGINE=generative
POLLY_MAX_CHARACTERS=3000

# In-memory cache of synthesised audio. Polly bills per character, so this
# makes repeated demos of the same sentence free.
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=200
CACHE_MAX_BYTES=52428800

# ---- Transcription -----------------------------------------------------------

# Lifetime of the presigned WebSocket URL, in seconds. Keep this short: the URL
# is a bearer credential granting direct access to AWS Transcribe.
TRANSCRIBE_URL_TTL=60
TRANSCRIBE_DEFAULT_LANGUAGE=en-US

# ---- Chat limits -------------------------------------------------------------

CHAT_MAX_MESSAGES=40
CHAT_MAX_TOTAL_CHARACTERS=50000
CHAT_MAX_SYSTEM_CHARACTERS=4000
